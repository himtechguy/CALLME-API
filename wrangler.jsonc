
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "callme-api",
  "main": "index.js",
  "compatibility_date": "2026-11-03",
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_ROOMS",
        "class_name": "CallRoom"
      }
    ]
  },
  "exports": {
    "CallRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
